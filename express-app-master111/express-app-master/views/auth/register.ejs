<%- include('../partials/header') %>

<section class="mx-auto max-w-md rounded-xl bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-bold">Register</h1>
  <% if (error) { %>
    <p class="mt-4 rounded bg-red-100 px-3 py-2 text-sm text-red-700"><%= error %></p>
  <% } %>
  <form action="/register" method="POST" class="mt-6 space-y-4">
    <div>
      <label class="text-sm font-medium" for="username">Username</label>
      <input class="mt-1 w-full rounded-lg border px-3 py-2" id="username" name="username" required>
    </div>
    <div>
      <label class="text-sm font-medium" for="password">Password</label>
      <input class="mt-1 w-full rounded-lg border px-3 py-2" id="password" name="password" type="password" required>
    </div>
    <button class="w-full rounded-lg bg-blue-700 px-4 py-2 text-white" type="submit">Create account</button>
  </form>
  <p class="mt-4 text-sm text-slate-600">Already have an account? <a href="/login" class="text-blue-700">Login</a></p>
</section>

<%- include('../partials/footer') %>
