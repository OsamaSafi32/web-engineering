<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task Manager</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-slate-100 text-slate-900">
  <nav class="border-b bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
      <a href="/tasks" class="font-bold">Task Manager</a>
      <div class="flex items-center gap-4 text-sm">
        <% if (currentUser) { %>
          <a href="/tasks/new" class="text-blue-700">New Task</a>
          <form action="/logout" method="POST">
            <button class="text-slate-700" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a href="/login" class="text-slate-700">Login</a>
          <a href="/register" class="text-blue-700">Register</a>
        <% } %>
      </div>
    </div>
  </nav>
  <main class="mx-auto max-w-5xl px-4 py-8">
