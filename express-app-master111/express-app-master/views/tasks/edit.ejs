<%- include('../partials/header') %>

<section class="mx-auto max-w-2xl rounded-xl bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-bold">Edit Task</h1>
  <% if (error) { %>
    <p class="mt-4 rounded bg-red-100 px-3 py-2 text-sm text-red-700"><%= error %></p>
  <% } %>
  <form action="/tasks/<%= task._id %>?_method=PUT" method="POST" class="mt-6 space-y-4">
    <div>
      <label class="text-sm font-medium" for="title">Title</label>
      <input class="mt-1 w-full rounded-lg border px-3 py-2" id="title" name="title" value="<%= task.title %>" required>
    </div>
    <div>
      <label class="text-sm font-medium" for="description">Description</label>
      <textarea class="mt-1 w-full rounded-lg border px-3 py-2" id="description" name="description" rows="4" required><%= task.description %></textarea>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <div>
        <label class="text-sm font-medium" for="status">Status</label>
        <select class="mt-1 w-full rounded-lg border px-3 py-2" id="status" name="status">
          <option value="pending" <%= task.status === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="in-progress" <%= task.status === 'in-progress' ? 'selected' : '' %>>In Progress</option>
          <option value="completed" <%= task.status === 'completed' ? 'selected' : '' %>>Completed</option>
        </select>
      </div>
      <div>
        <label class="text-sm font-medium" for="priority">Priority</label>
        <select class="mt-1 w-full rounded-lg border px-3 py-2" id="priority" name="priority">
          <option value="low" <%= task.priority === 'low' ? 'selected' : '' %>>Low</option>
          <option value="medium" <%= task.priority === 'medium' ? 'selected' : '' %>>Medium</option>
          <option value="high" <%= task.priority === 'high' ? 'selected' : '' %>>High</option>
        </select>
      </div>
      <div>
        <label class="text-sm font-medium" for="dueDate">Due Date</label>
        <input class="mt-1 w-full rounded-lg border px-3 py-2" id="dueDate" name="dueDate" type="date" value="<%= task.dueDate ? task.dueDate.toISOString().split('T')[0] : '' %>">
      </div>
    </div>
    <div class="flex gap-3">
      <button class="rounded-lg bg-blue-700 px-4 py-2 text-white" type="submit">Update</button>
      <a href="/tasks/<%= task._id %>" class="rounded-lg border px-4 py-2">Cancel</a>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
