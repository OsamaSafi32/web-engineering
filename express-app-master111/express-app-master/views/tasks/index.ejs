<%- include('../partials/header') %>

<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-3xl font-bold">My Tasks</h1>
    <p class="mt-1 text-slate-600">Keep track of what you need to finish.</p>
  </div>
  <a href="/tasks/new" class="rounded-lg bg-blue-700 px-4 py-2 text-center text-white">Add Task</a>
</div>

<% if (tasks.length === 0) { %>
  <section class="mt-8 rounded-xl bg-white p-8 text-center shadow-sm">
    <h2 class="text-xl font-semibold">No tasks yet</h2>
    <p class="mt-2 text-slate-600">Create your first task to get started.</p>
  </section>
<% } else { %>
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    <% tasks.forEach((task) => { %>
      <article class="rounded-xl bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold"><%= task.title %></h2>
            <p class="mt-2 line-clamp-2 text-sm text-slate-600"><%= task.description %></p>
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs"><%= task.priority %></span>
        </div>
        <div class="mt-4 flex flex-wrap gap-2 text-sm text-slate-600">
          <span>Status: <%= task.status %></span>
          <% if (task.dueDate) { %>
            <span>Due: <%= task.dueDate.toISOString().split('T')[0] %></span>
          <% } %>
        </div>
        <div class="mt-5 flex gap-3 text-sm">
          <a href="/tasks/<%= task._id %>" class="text-blue-700">View</a>
          <a href="/tasks/<%= task._id %>/edit" class="text-slate-700">Edit</a>
          <form action="/tasks/<%= task._id %>?_method=DELETE" method="POST">
            <button class="text-red-700" type="submit">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
