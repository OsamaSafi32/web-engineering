<%- include('../partials/header') %>

<article class="mx-auto max-w-2xl rounded-xl bg-white p-6 shadow-sm">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold"><%= task.title %></h1>
      <p class="mt-2 text-slate-600"><%= task.description %></p>
    </div>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-sm"><%= task.priority %></span>
  </div>
  <dl class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="rounded-lg bg-slate-50 p-4">
      <dt class="text-sm text-slate-500">Status</dt>
      <dd class="mt-1 font-medium"><%= task.status %></dd>
    </div>
    <div class="rounded-lg bg-slate-50 p-4">
      <dt class="text-sm text-slate-500">Due Date</dt>
      <dd class="mt-1 font-medium"><%= task.dueDate ? task.dueDate.toISOString().split('T')[0] : 'No date' %></dd>
    </div>
  </dl>
  <div class="mt-6 flex gap-3">
    <a href="/tasks/<%= task._id %>/edit" class="rounded-lg bg-blue-700 px-4 py-2 text-white">Edit</a>
    <a href="/tasks" class="rounded-lg border px-4 py-2">Back</a>
    <form action="/tasks/<%= task._id %>?_method=DELETE" method="POST">
      <button class="rounded-lg border border-red-200 px-4 py-2 text-red-700" type="submit">Delete</button>
    </form>
  </div>
</article>

<%- include('../partials/footer') %>
